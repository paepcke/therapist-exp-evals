<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent for sparky: pulls the backups every hour, and when the laptop wakes or the
  user logs in. Install: see backup_install.md. Check the python path first:
      ls /Users/paepcke/anaconda3/envs/therapist-exp-evals/bin/python
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.thtrainer.backup-pull</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/paepcke/anaconda3/envs/therapist-exp-evals/bin/python</string>
        <string>-m</string>
        <string>backup_pull.backup_puller</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/paepcke/Backups/thtrainer/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/paepcke/Backups/thtrainer/launchd.log</string>
</dict>
</plist>
