[Unit]
Description=Nightly snapshot of the evaluation database

[Timer]
OnCalendar=*-*-* 03:30:00
RandomizedDelaySec=300
# Run at the next boot if the machine was off at the scheduled time:
Persistent=true

[Install]
WantedBy=timers.target
